# =============================================
# Stitch Vortex Labs Backend - Environment Config
# =============================================
# Copy this file to .env and fill in your values

# --- Server ---
PORT=5000
NODE_ENV=development

# --- MongoDB ---
# Local MongoDB (default for development)
MONGO_URI=mongodb://localhost:27017/stitch_vortex_labs

# --- JWT ---
JWT_SECRET=stitch_vortex_labs_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# --- CORS ---
# Frontend origin (allow requests from your frontend)
FRONTEND_URL=http://localhost:3000

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
